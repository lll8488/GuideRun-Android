<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="4dp" android:elevation="1dp" app:cardCornerRadius="14dp"
    android:clickable="true" android:focusable="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical"
        android:background="#FFFFFF">
        <View android:layout_width="6dp" android:layout_height="6dp"
            android:background="#0D7C29" android:layout_marginEnd="10dp"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/tv_order_item"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="" android:textSize="14sp" android:textColor="#1A1A2E" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
