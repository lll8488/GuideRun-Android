<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textSize="22sp"
            android:textColor="#333333"
            android:contentDescription="返回"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="需求详情"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />

        <!-- 信息卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:elevation="2dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">

                <TextView
                    android:id="@+id/tv_detail_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 跑步地点"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20" />

                <!-- PRD 4.6: 静态地图卡片约300×200dp -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="跑步地点静态地图">

                    <ImageView
                        android:id="@+id/iv_static_map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="跑步地点地图" />

                    <LinearLayout
                        android:id="@+id/map_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:background="#E8F5E9"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="40sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="加载地图中..."
                            android:textSize="13sp"
                            android:textColor="#999999" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_detail_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#AAAAAA" />

                <!-- 分割线 — 装饰性 -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginVertical="16dp" android:background="#F0F0F0"
                    android:importantForAccessibility="no" />

                <!-- 信息行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="日期" android:textSize="12sp" android:textColor="#BBBBBB" />
                        <TextView android:id="@+id/tv_detail_date" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="时长" android:textSize="12sp" android:textColor="#BBBBBB" />
                        <TextView android:id="@+id/tv_detail_duration" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="距离" android:textSize="12sp" android:textColor="#BBBBBB" />
                        <TextView android:id="@+id/tv_detail_distance" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="4dp"
                            android:text="" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_navigate"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:text="🗺  导航到此处"
                    android:textSize="15sp"
                    android:textColor="#1B5E20"
                    android:background="@drawable/btn_outline_round"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 接单按钮 -->
        <Button
            android:id="@+id/btn_accept"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="确认接单"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_green_round"
            android:contentDescription="确认接单按钮"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>
</ScrollView>
