<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1B5E20"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">
        <Button
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:background="@android:color/transparent"
            android:minWidth="0dp" android:minHeight="0dp" />
        <TextView
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="志愿者排行榜"
            android:textColor="#FFFFFF"
            android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#F1F8E9">
        <TextView
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="排名"
            android:textColor="#689F38" android:textStyle="bold" android:textSize="14sp" />
        <TextView
            android:layout_width="0dp" android:layout_weight="2"
            android:layout_height="wrap_content" android:text="志愿者"
            android:textColor="#689F38" android:textStyle="bold" android:textSize="14sp" />
        <TextView
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="次数"
            android:textColor="#689F38" android:textStyle="bold" android:textSize="14sp" />
        <TextView
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="评分"
            android:textColor="#689F38" android:textStyle="bold" android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_leaderboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp" />
</LinearLayout>
