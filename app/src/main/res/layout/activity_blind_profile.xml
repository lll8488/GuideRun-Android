<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="←"
            android:textSize="28sp"
            android:textColor="#333333"
            android:contentDescription="返回"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="个人中心"
            android:textColor="#1B5E20"
            android:textSize="28sp"
            android:textStyle="bold"
            android:contentDescription="个人中心" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:hint="姓名"
            android:textSize="20sp"
            android:paddingStart="20dp"
            android:contentDescription="姓名输入框"
            android:background="@drawable/edit_bg" />

        <EditText
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:hint="联系方式"
            android:inputType="phone"
            android:textSize="20sp"
            android:paddingStart="20dp"
            android:contentDescription="联系方式输入框"
            android:background="@drawable/edit_bg" />

        <Button
            android:id="@+id/btn_emergency"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:text="紧急联系人设置"
            android:textSize="22sp"
            android:textColor="#E65100"
            android:background="@drawable/btn_outline_orange"
            android:contentDescription="紧急联系人设置按钮"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="20dp"
            android:text="保存"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_green_round"
            android:contentDescription="保存按钮"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="辅助功能设置"
            android:textSize="18sp"
            android:textColor="#1B5E20"
            android:background="@drawable/btn_outline_round"
            android:contentDescription="辅助功能设置按钮"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_switch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="切换到志愿者身份"
            android:textSize="17sp"
            android:textColor="#8A8D93"
            android:background="@android:color/transparent"
            android:contentDescription="切换到志愿者身份按钮"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#F0F0F0"
            android:importantForAccessibility="no" />

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="退出登录"
            android:textSize="17sp"
            android:textColor="#D32F2F"
            android:background="@drawable/btn_outline_round"
            android:contentDescription="退出登录按钮"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>
</ScrollView>
