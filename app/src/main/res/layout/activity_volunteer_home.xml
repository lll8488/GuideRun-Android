<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#0D7C29"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="助盲跑"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btn_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="👤"
            android:textSize="20sp"
            android:gravity="center"
            android:contentDescription="个人中心" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="2dp"
                app:cardCornerRadius="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="#FFFFFF">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="你好，志愿者"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="今天有帮助视障跑者的计划吗？"
                        android:textSize="14sp"
                        android:textColor="#8A8D93" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_demand_list"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="3dp"
                    android:contentDescription="待接单需求列表"
                    app:cardCornerRadius="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#FFFFFF">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📋" android:textSize="32sp" android:importantForAccessibility="no" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="待接单"
                            android:textSize="15sp" android:textStyle="bold" android:textColor="#1A1A2E" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_training"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="3dp"
                    android:contentDescription="陪跑训练营"
                    app:cardCornerRadius="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="#FFFFFF">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📖" android:textSize="32sp" android:importantForAccessibility="no" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="训练营"
                            android:textSize="15sp" android:textStyle="bold" android:textColor="#1A1A2E" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:elevation="2dp"
                app:cardCornerRadius="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="#FFFFFF">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📊 我的贡献" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="#1A1A2E" />
                    <TextView android:id="@+id/tv_volunteer_stats"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text="暂无记录"
                        android:textSize="14sp" android:textColor="#8A8D93" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btn_leaderboard"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:contentDescription="志愿者排行榜"
                app:cardCornerRadius="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:gravity="center_vertical"
                    android:background="#FFFFFF">
                    <TextView
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="🏆 志愿者排行榜"
                        android:textSize="16sp" android:textStyle="bold" android:textColor="#1A1A2E" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textSize="22sp" android:textColor="#CCCCCC" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="📋 我的接单"
                android:textSize="16sp" android:textStyle="bold" android:textColor="#1A1A2E" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_my_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="我的接单列表" />

            <TextView
                android:id="@+id/tv_completed_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="✅ 已完成记录"
                android:textSize="16sp" android:textStyle="bold" android:textColor="#1A1A2E"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_completed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="已完成跑步记录"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
