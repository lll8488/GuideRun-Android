<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="#F5F6FA">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="🏃"
            android:textSize="56sp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="助盲跑"
            android:textColor="#0D7C29"
            android:textSize="32sp"
            android:textStyle="bold"
            android:contentDescription="助盲跑" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="36dp"
            android:text="手机号验证码登录"
            android:textColor="#8A8D93"
            android:textSize="14sp" />

        <!-- 登录卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="2dp"
            app:cardCornerRadius="20dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="#FFFFFF">

                <!-- 手机号 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手机号"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_phone"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:hint="请输入11位手机号"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:contentDescription="手机号输入框"
                    android:textSize="17sp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/edit_bg" />

                <!-- 验证码 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="验证码"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_code"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="6位验证码"
                        android:inputType="number"
                        android:maxLength="6"
                        android:contentDescription="验证码输入框"
                        android:textSize="17sp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/edit_bg" />

                    <Button
                        android:id="@+id/btn_get_code"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:text="获取验证码"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/btn_green_round"
                        android:contentDescription="获取验证码按钮"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="14dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:text="登  录"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:contentDescription="登录按钮"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/btn_green_round" />

                <Button
                    android:id="@+id/btn_register"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="注册新账号"
                    android:textSize="15sp"
                    android:textColor="#0D7C29"
                    android:contentDescription="注册新账号按钮"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/btn_outline_round" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="登录即表示同意《用户协议》和《隐私政策》"
            android:textColor="#BDBDBD"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
