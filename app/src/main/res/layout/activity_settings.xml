<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <Button android:id="@+id/btn_back"
            android:layout_width="48dp" android:layout_height="48dp"
            android:text="←" android:textSize="24sp" android:textColor="#1A1A2E"
            android:contentDescription="返回" android:minWidth="0dp" android:minHeight="0dp"
            android:background="@android:color/transparent" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:layout_marginBottom="20dp"
            android:text="辅助功能设置" android:textColor="#1A1A2E"
            android:textSize="26sp" android:textStyle="bold" />

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:elevation="1dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" app:cardCornerRadius="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="0dp" android:background="#FFFFFF">

                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:paddingHorizontal="18dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="高对比度黑白主题" android:textSize="16sp" android:textStyle="bold"
                            android:textColor="#1A1A2E" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="重启应用后生效" android:textSize="12sp" android:textColor="#8A8D93" />
                    </LinearLayout>
                    <android.widget.Switch android:id="@+id/sw_contrast"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:contentDescription="高对比度主题开关" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="#F0F0F0" android:layout_marginStart="18dp"
                    android:importantForAccessibility="no" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:paddingHorizontal="18dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="页面跳转语音提示" android:textSize="16sp" android:textStyle="bold"
                            android:textColor="#1A1A2E" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="跳转页面时播报目的地" android:textSize="12sp" android:textColor="#8A8D93" />
                    </LinearLayout>
                    <android.widget.Switch android:id="@+id/sw_nav_voice"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:contentDescription="页面跳转语音开关" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="#F0F0F0" android:layout_marginStart="18dp"
                    android:importantForAccessibility="no" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:paddingHorizontal="18dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="跑步语音口令播报" android:textSize="16sp" android:textStyle="bold"
                            android:textColor="#1A1A2E" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="跑步时按设定间隔播报" android:textSize="12sp" android:textColor="#8A8D93" />
                    </LinearLayout>
                    <android.widget.Switch android:id="@+id/sw_voice_prompts"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:contentDescription="跑步语音播报开关" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="语音播报间隔"
            android:textSize="16sp" android:textStyle="bold" android:textColor="#1A1A2E" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/btn_15s"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginEnd="4dp" android:text="15秒" android:textSize="15sp"
                android:background="@drawable/btn_light_round" android:minWidth="0dp" android:minHeight="0dp" />
            <Button android:id="@+id/btn_30s"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginHorizontal="2dp" android:text="30秒" android:textSize="15sp"
                android:background="@drawable/btn_green_round" android:textColor="#FFFFFF"
                android:minWidth="0dp" android:minHeight="0dp" />
            <Button android:id="@+id/btn_60s"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="4dp" android:text="60秒" android:textSize="15sp"
                android:background="@drawable/btn_light_round" android:minWidth="0dp" android:minHeight="0dp" />
        </LinearLayout>

        <Button android:id="@+id/btn_privacy"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="28dp" android:text="查看隐私政策"
            android:textSize="15sp" android:textColor="#0D7C29"
            android:background="@drawable/btn_outline_round"
            android:contentDescription="查看隐私政策" android:minWidth="0dp" android:minHeight="0dp" />
    </LinearLayout>
</ScrollView>
