<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F6FA">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:background="#0D7C29" android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <Button android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp"
            android:text="←" android:textSize="22sp" android:textColor="#FFFFFF"
            android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="在线考核" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
            android:gravity="center" />
        <View android:layout_width="48dp" android:layout_height="48dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:background="#FFFFFF">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="10道判断题 · 满分100分" android:textSize="13sp" android:textColor="#8A8D93" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="80分通过" android:textSize="13sp" android:textStyle="bold" android:textColor="#E65100" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="10dp">
        <LinearLayout android:id="@+id/questions_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button android:id="@+id/btn_submit" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_margin="10dp" android:text="提交考核"
        android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF"
        android:background="@drawable/btn_green_round" android:minWidth="0dp" android:minHeight="0dp" />
</LinearLayout>
